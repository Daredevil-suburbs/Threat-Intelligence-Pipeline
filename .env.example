# ============================================================
# Threat Intelligence Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----------------------------------------------------------
# API Keys (OPTIONAL — pipeline works without these,
# enrichment steps will be skipped gracefully)
# ----------------------------------------------------------

# VirusTotal Free API Key
# Get it at: https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500/day
VIRUSTOTAL_API_KEY=

# AbuseIPDB Free API Key
# Get it at: https://www.abuseipdb.com/register
# Free tier: 1000 checks/day
ABUSEIPDB_API_KEY=

# ----------------------------------------------------------
# Elasticsearch (leave as-is if using docker-compose)
# ----------------------------------------------------------
ES_HOST=http://localhost:9200
ES_INDEX=threat-intel-iocs

# ----------------------------------------------------------
# Pipeline Settings
# ----------------------------------------------------------

# How many IOCs to fetch per source per run
MAX_IOCS_PER_SOURCE=500

# How often to run the pipeline (hours)
RUN_INTERVAL_HOURS=6

# Local SQLite database path
DB_PATH=data/threat_intel.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
